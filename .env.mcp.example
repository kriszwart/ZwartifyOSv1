# MCP Server Configuration Example
# Copy this to .env.local and configure your MCP servers

# ===========================================
# Slack MCP Server
# ===========================================
# MCP_SLACK_ENDPOINT=https://api.slack.com/mcp
# MCP_SLACK_API_KEY=xoxb-your-slack-bot-token
# MCP_SLACK_ENABLED=true
# MCP_SLACK_TYPE=http
# MCP_SLACK_CAPABILITIES=messaging,channels,users

# ===========================================
# Discord MCP Server
# ===========================================
# MCP_DISCORD_ENDPOINT=https://discord.com/api/mcp
# MCP_DISCORD_API_KEY=your-discord-bot-token
# MCP_DISCORD_ENABLED=true
# MCP_DISCORD_TYPE=http
# MCP_DISCORD_CAPABILITIES=messaging,channels,guilds

# ===========================================
# Twitter/X MCP Server
# ===========================================
# MCP_TWITTER_ENDPOINT=https://api.twitter.com/mcp
# MCP_TWITTER_API_KEY=your-twitter-api-key
# MCP_TWITTER_ENABLED=true
# MCP_TWITTER_TYPE=http
# MCP_TWITTER_CAPABILITIES=posting,reading,users

# ===========================================
# GitHub MCP Server
# ===========================================
# MCP_GITHUB_ENDPOINT=https://api.github.com/mcp
# MCP_GITHUB_API_KEY=ghp_your-github-token
# MCP_GITHUB_ENABLED=true
# MCP_GITHUB_TYPE=http
# MCP_GITHUB_CAPABILITIES=repositories,issues,pull_requests

# ===========================================
# Notion MCP Server
# ===========================================
# MCP_NOTION_ENDPOINT=https://api.notion.com/mcp
# MCP_NOTION_API_KEY=secret_your-notion-integration-token
# MCP_NOTION_ENABLED=true
# MCP_NOTION_TYPE=http
# MCP_NOTION_CAPABILITIES=pages,databases,blocks

# ===========================================
# Linear MCP Server
# ===========================================
# MCP_LINEAR_ENDPOINT=https://api.linear.app/mcp
# MCP_LINEAR_API_KEY=lin_api_your-linear-api-key
# MCP_LINEAR_ENABLED=true
# MCP_LINEAR_TYPE=http
# MCP_LINEAR_CAPABILITIES=issues,projects,teams

# ===========================================
# Custom MCP Server Example
# ===========================================
# MCP_CUSTOM_ENDPOINT=https://your-custom-mcp-server.com
# MCP_CUSTOM_API_KEY=your-api-key
# MCP_CUSTOM_ENABLED=true
# MCP_CUSTOM_TYPE=http
# MCP_CUSTOM_CAPABILITIES=custom,capabilities

# ===========================================
# Notes:
# ===========================================
# - Replace "CUSTOM" with your platform name (e.g., SALESFORCE, HUBSPOT)
# - All server names are case-insensitive
# - Only ENDPOINT is required, other fields are optional
# - ENABLED defaults to true
# - TYPE defaults to http
# - CAPABILITIES are comma-separated values

# ===========================================
# Testing MCP Servers:
# ===========================================
# 1. Start the application: npm run dev
# 2. Check server status: GET http://localhost:3000/api/mcp/status
# 3. Run health check: POST http://localhost:3000/api/mcp/health-check
# 4. Auto-detect servers: POST http://localhost:3000/api/mcp/auto-detect
#    with body: {"input": "I need to post to Slack and Twitter"}
