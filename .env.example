# ZwartifyOS Environment Variables

# ============================================
# REQUIRED - Core Configuration
# ============================================

# Your Anthropic API key (required for agent functionality)
# Get your key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_anthropic_api_key_here

# ============================================
# OPTIONAL - Security & Authentication
# ============================================

# API Key Authentication (optional)
# Uncomment to enable API key authentication for your endpoints
# API_KEY=your-secret-api-key-here

# ============================================
# OPTIONAL - Rate Limiting
# ============================================

# Enable rate limiting (optional)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# ============================================
# OPTIONAL - Claude Code for Web Sync
# ============================================

# Enable automatic sync from Claude Code for Web branches
# SYNC_ENABLED=true
# SYNC_INTERVAL=30000

# ============================================
# OPTIONAL - Application Settings
# ============================================

# Public API URL (for deployed environments)
# NEXT_PUBLIC_API_URL=https://your-deployed-app.vercel.app

# Node environment
# NODE_ENV=development
